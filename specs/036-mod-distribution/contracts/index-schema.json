{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plix.dev/schemas/registry-index-v1.json",
  "title": "Plix Registry Index v1",
  "description": "Schema for mod registry index.json files",
  "type": "object",
  "required": ["registry_version", "name", "mods"],
  "properties": {
    "registry_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version, always 1 for this schema"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable registry name"
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "description": "Base URL for relative download URLs"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (RFC 3339)"
    },
    "mods": {
      "type": "array",
      "items": { "$ref": "#/definitions/RegistryMod" },
      "description": "All mods in this registry"
    }
  },
  "definitions": {
    "ModId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Mod identifier (lowercase alphanumeric + hyphens)"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version string"
    },
    "SemVerReq": {
      "type": "string",
      "description": "SemVer version requirement (e.g., ^1.0, ~2.1, >=1.0.0)"
    },
    "SHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash (64 hex characters)"
    },
    "Ed25519Signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$",
      "description": "Ed25519 signature (128 hex characters)"
    },
    "KeyId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "Signing key ID (first 8 bytes of public key, hex)"
    },
    "RegistryMod": {
      "type": "object",
      "required": ["id", "name", "versions"],
      "properties": {
        "id": { "$ref": "#/definitions/ModId" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Short description"
        },
        "author": {
          "type": "string",
          "maxLength": 100,
          "description": "Author name"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "description": "Homepage URL"
        },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ModVersion" },
          "minItems": 1,
          "description": "All available versions (newest first recommended)"
        }
      }
    },
    "ModVersion": {
      "type": "object",
      "required": ["version", "sha256", "download_url", "size", "api_version"],
      "properties": {
        "version": { "$ref": "#/definitions/SemVer" },
        "sha256": { "$ref": "#/definitions/SHA256" },
        "download_url": {
          "type": "string",
          "description": "Download URL (absolute or relative to base_url)"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800,
          "description": "Bundle size in bytes (max 50 MB)"
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/definitions/ModDependency" },
          "default": [],
          "description": "Dependencies with version constraints"
        },
        "api_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Required plix mod API version"
        },
        "engine": {
          "$ref": "#/definitions/EngineConstraint",
          "description": "Optional engine version constraints"
        },
        "signature": {
          "$ref": "#/definitions/Ed25519Signature",
          "description": "Optional Ed25519 signature"
        },
        "signer": {
          "$ref": "#/definitions/KeyId",
          "description": "Signing key ID"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "description": "Publication timestamp (RFC 3339)"
        },
        "yanked": {
          "type": "boolean",
          "default": false,
          "description": "If true, version should not be installed"
        }
      }
    },
    "ModDependency": {
      "type": "object",
      "required": ["id", "version_req"],
      "properties": {
        "id": { "$ref": "#/definitions/ModId" },
        "version_req": { "$ref": "#/definitions/SemVerReq" },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, dependency is optional"
        }
      }
    },
    "EngineConstraint": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/definitions/SemVer",
          "description": "Minimum engine version (inclusive)"
        },
        "max": {
          "$ref": "#/definitions/SemVer",
          "description": "Maximum engine version (inclusive)"
        }
      }
    }
  },
  "examples": [
    {
      "registry_version": 1,
      "name": "Official Plix Mods",
      "base_url": "https://mods.plix.dev/",
      "updated_at": "2025-12-18T12:00:00Z",
      "mods": [
        {
          "id": "core-lib",
          "name": "Core Library",
          "description": "Shared utilities for mod development",
          "author": "Plix Team",
          "homepage": "https://github.com/plix/core-lib",
          "versions": [
            {
              "version": "1.2.0",
              "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
              "download_url": "bundles/core-lib-1.2.0.plixmod",
              "size": 102400,
              "dependencies": [],
              "api_version": 1,
              "published_at": "2025-12-15T10:00:00Z"
            },
            {
              "version": "1.1.0",
              "sha256": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
              "download_url": "bundles/core-lib-1.1.0.plixmod",
              "size": 98000,
              "dependencies": [],
              "api_version": 1,
              "published_at": "2025-12-01T10:00:00Z"
            }
          ]
        },
        {
          "id": "weapons-pack",
          "name": "Weapons Pack",
          "description": "Additional weapons for combat",
          "author": "ModAuthor",
          "versions": [
            {
              "version": "2.0.0",
              "sha256": "b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3",
              "download_url": "bundles/weapons-pack-2.0.0.plixmod",
              "size": 512000,
              "dependencies": [
                { "id": "core-lib", "version_req": "^1.0" }
              ],
              "api_version": 1,
              "engine": { "min": "0.36.0" },
              "signature": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
              "signer": "abc123def456abc1",
              "published_at": "2025-12-18T08:00:00Z"
            }
          ]
        }
      ]
    }
  ]
}
