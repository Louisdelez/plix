# =============================================================================
# Plix Server Docker Compose Environment Variables
# Feature 028: Dedicated Server Packaging
# =============================================================================
# Copy this file to .env and customize for your deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Server Identity
# -----------------------------------------------------------------------------

# Display name in server browser
PLIX_SERVER_NAME=My Plix Server

# Geographic region (e.g., eu-west, us-east, asia-pacific)
PLIX_REGION=unknown

# Server tags for filtering (comma-separated)
PLIX_TAGS=casual,vanilla

# -----------------------------------------------------------------------------
# Network Ports
# -----------------------------------------------------------------------------

# Game server UDP port (host:container mapping)
PLIX_PORT=7777

# Master server HTTP port (host:container mapping)
PLIX_MASTER_PORT=8080

# -----------------------------------------------------------------------------
# Gameplay
# -----------------------------------------------------------------------------

# Game mode: ffa, tdm, ctf, br_lite
PLIX_GAME_MODE=ffa

# Arena name (from assets/arenas/)
PLIX_ARENA=test_arena

# Maximum concurrent players
PLIX_MAX_PLAYERS=16

# Server tick rate (20-60 Hz)
PLIX_TICKRATE=60

# -----------------------------------------------------------------------------
# Master Server Registration
# -----------------------------------------------------------------------------

# Master server URL (for server browser registration)
# Default uses compose internal network (plix-master service)
PLIX_MASTER_URL=http://plix-master:8080

# -----------------------------------------------------------------------------
# Master Server Configuration (when running plix-master)
# -----------------------------------------------------------------------------

# Time-to-live for server entries (seconds)
PLIX_MASTER_TTL=60

# Rate limit for heartbeats per IP per minute
PLIX_MASTER_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: trace, debug, info, warn, error
# Can also use RUST_LOG for more granular control
RUST_LOG=info
